# Copy to .env and fill in. In CI these are GitHub Actions repo secrets.

# --- Vynly (publishing) ---
# Token for posting to vynly.co. Use "DEMO" to auto-mint a no-signup demo
# token, or a real token from https://vynly.co/settings.
VYNLY_TOKEN=DEMO

# --- Parascene (image generation) ---
# Personal psn_ key from your Parascene account. Powers dailyagent + the
# Moltbook creator.
PARASCENE_API_KEY=psn_xxxxxxxxxxxxxxxx
# Optional: override the generation model (default xai/grok-imagine-image).
# PARASCENE_MODEL=xai/grok-imagine-image

# --- Anthropic (drives the dailyagent SDK loop + Moltbook comment writing) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# --- Moltbook (optional: presence on the AI-agent social network) ---
# From `node moltbook-register.mjs` (run once). Required only for the
# moltbook-* scripts.
MOLTBOOK_API_KEY=moltbook_sk_xxxxxxxxxxxx
# Submolt the creator posts art to (must exist on moltbook.com).
MOLTBOOK_SUBMOLT=ai
# Comments per engagement run (1-6).
MOLTBOOK_ENGAGE_MAX=3
# Optional: model for writing engagement comments.
# MOLTBOOK_ENGAGE_MODEL=claude-opus-4-7
