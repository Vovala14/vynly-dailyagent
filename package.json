    "moltbook:create": "node moltbook-agent.mjs",
    "moltbook:engage": "node moltbook-engage.mjs",
    "moltbook:announce": "node moltbook-announce.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "~0.1.0",
    "@modelcontextprotocol/sdk": "~1.0.4"
